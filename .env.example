# CulinaryVerse AI Environment Configuration Example
# Copy this file to .env.local and populate with your authorized credentials.

# Node Environment
NODE_ENV=production

# Public Site Configuration
NEXT_PUBLIC_APP_NAME="CulinaryVerse AI"
NEXT_PUBLIC_APP_URL="https://culinaryverse-ai.vercel.app"

# Optional External AI API Keys (for live LLM streaming endpoints)
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""

# Optional Retailer Partner Affiliate IDs (disclosed transparently)
# AMAZON_ASSOCIATE_TAG=""
# FLIPKART_AFFILIATE_ID=""
